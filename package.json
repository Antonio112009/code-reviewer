{
  "name": "@antonio112009/code-reviewer",
  "version": "0.13.1",
  "description": "Next-level LLM code review: version-aware skills, static hints and self-critique for fewer false positives. Works with Claude Code, Codex, Copilot, Gemini, the Anthropic API, AWS Bedrock and OpenAI-compatible APIs (Ollama, OpenRouter, …).",
  "keywords": [
    "code-review",
    "code-reviewer",
    "llm",
    "ai",
    "cli",
    "static-analysis",
    "security",
    "claude-code",
    "codex",
    "copilot",
    "gemini",
    "bedrock",
    "anthropic",
    "openai",
    "ollama",
    "pre-commit",
    "agent-client-protocol"
  ],
  "type": "module",
  "license": "MIT",
  "author": "antonio112009",
  "homepage": "https://antonio112009.github.io/code-reviewer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antonio112009/code-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/Antonio112009/code-reviewer/issues"
  },
  "bin": {
    "code-reviewer": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "evals",
    "!evals/aacr",
    "!evals/martian",
    "!evals/experiments",
    "!evals/*.py",
    "!evals/*.sh",
    "!evals/**/__pycache__",
    "README.md",
    "CHANGELOG.md",
    "docs/assets/logo.svg",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@ai-sdk/amazon-bedrock": "5.0.135",
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.87",
    "@aws-sdk/credential-providers": "3.1164.0",
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@secretlint/core": "13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "ai": "7.0.165",
    "aws4fetch": "1.0.20",
    "commander": "15.1.0",
    "es-module-lexer": "3.0.4",
    "execa": "10.2.1",
    "gpt-tokenizer": "4.1.0",
    "log-update": "8.0.0",
    "p-limit": "7.3.3",
    "picocolors": "1.1.1",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "terminal-link": "5.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@ast-grep/cli": "0.51.1"
  }
}
