 ): string {
   const preExisting = mode === 'diff' ? ', or a pre-existing problem this change does not touch' : '';
+  // EXPERIMENT ONLY (never merged, CR_EXP=sevkeep): the critic keeps the reviewer's severity, and the confidence of a
+  // reviewer-major finding, unless code shows a smaller failure.
+  const sevkeep = depth === 'full' && (process.env.CR_EXP ?? '').split(',').includes('sevkeep');
   // Essential depth drops low-impact findings on purpose; full depth keeps every real defect, so there a
