@@ -46,6 +46,57 @@ def _get_llm_client():
     return _llm_client
 
 
+# JUDGE_BACKEND=claude-cli: the same judge prompt answered by `claude -p` (no API key needed).
+USE_CLAUDE_CLI = os.getenv("JUDGE_BACKEND", "") == "claude-cli"
+_CLAUDE_JUDGE_MODEL = os.getenv("JUDGE_CLAUDE_MODEL", "sonnet")
+# One semaphore per event loop: `--eval-rounds` runs one asyncio.run() per round, and a semaphore created in
+# an earlier loop blocks forever in the next one.
+_claude_semaphores: Dict[Any, Any] = {}
+judge_error_count = 0
+judge_cost_usd = 0.0
+
+
+async def _claude_cli_judge(prompt: str) -> Dict[str, Any]:
+    import asyncio
+    import json as _json
+
+    loop = asyncio.get_running_loop()
+    semaphore = _claude_semaphores.get(loop)
+    if semaphore is None:
+        semaphore = _claude_semaphores[loop] = asyncio.Semaphore(int(os.getenv("JUDGE_CONCURRENCY", "8")))
+    command = [
+        "claude", "-p", "--model", _CLAUDE_JUDGE_MODEL, "--output-format", "json",
+        "--system-prompt", "You judge code review comments. Reply with exactly one word: yes or no.",
+        "--tools", "", "--strict-mcp-config", "--setting-sources", "", "--no-session-persistence",
+    ]
+    last_error = ""
+    for attempt in range(3):
+        async with semaphore:
+            proc = await asyncio.create_subprocess_exec(
+                *command,
+                stdin=asyncio.subprocess.PIPE,
+                stdout=asyncio.subprocess.PIPE,
+                stderr=asyncio.subprocess.PIPE,
+            )
+            out, err = await proc.communicate(prompt.encode("utf-8"))
+        try:
+            data = _json.loads(out.decode("utf-8"))
+            if data.get("is_error"):
+                raise ValueError(str(data.get("result"))[:300])
+            result_text = str(data.get("result", "")).strip().lower()
+            is_similar = result_text.startswith("yes")
+            global judge_cost_usd
+            judge_cost_usd += float(data.get("total_cost_usd") or 0)
+            return {"is_similar": is_similar, "reason": result_text, "cost": data.get("total_cost_usd")}
+        except Exception as error:  # noqa: BLE001
+            last_error = f"{error}; stderr={err.decode('utf-8', 'replace')[-300:]}"
+            await asyncio.sleep(5 * (attempt + 1))
+    global judge_error_count
+    judge_error_count += 1
+    logging.error("claude judge failed: %s", last_error)
+    return {"is_similar": False, "reason": f"judge error: {last_error}", "judge_error": True}
+
+
