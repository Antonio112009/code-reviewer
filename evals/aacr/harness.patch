+def build_target_comments_from_code_reviewer(result: Dict[str, Any]) -> List[Dict[str, Any]]:
+    """code-reviewer report.json findings -> comments; note = title + description (failure) + suggestion."""
+    report = result.get("report")
+    if not isinstance(report, dict):
+        return []
+    comments = []
+    # "Worth a look" findings are in the report the user reads, so they count as review comments too.
+    for finding in [*(report.get("findings") or []), *(report.get("advisory") or []), *(report.get("notes") or [])]:
+        if not isinstance(finding, dict):
+            continue
+        parts = [
+            (finding.get("title") or "").strip(),
+            (finding.get("description") or "").strip(),
+            (finding.get("suggestion") or "").strip(),
+        ]
+        note = "\n".join(part for part in parts if part).strip()
+        if not note:
+            continue
+        line_range = _normalize_line_range(finding.get("startLine"), finding.get("endLine"))
+        comments.append(
+            {
+                "note": note,
+                "path": finding.get("file", ""),
+                "side": "right",
+                "from_line": line_range["from_line"],
+                "to_line": line_range["to_line"],
+            }
+        )
+    return comments
+
+
